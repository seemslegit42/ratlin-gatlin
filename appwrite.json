{
  "projectId": "$APPWRITE_PROJECT_ID",
  "projectName": "Beepin",
  "databases": [
    {
      "name": "Sovereign",
      "$id": "sovereign",
      "enabled": true,
      "collections": [
        {
          "name": "Ledger",
          "$id": "ledger",
          "enabled": true,
          "permissions": [],
          "documentSecurity": false,
          "attributes": [
            {
              "key": "syndicate_id",
              "type": "string",
              "status": "available",
              "required": true,
              "array": false
            },
            {
              "key": "balance",
              "type": "float",
              "status": "available",
              "required": true,
              "default": 0,
              "array": false
            },
            {
              "key": "committed",
              "type": "float",
              "status": "available",
              "required": true,
              "default": 0,
              "array": false
            },
            {
              "key": "reserved",
              "type": "float",
              "status": "available",
              "required": true,
              "default": 0,
              "array": false
            },
            {
              "key": "updated_at",
              "type": "datetime",
              "status": "available",
              "required": false,
              "array": false
            }
          ],
          "indexes": [
            {
              "key": "syndicate_id",
              "type": "key",
              "attributes": ["syndicate_id"]
            }
          ]
        },
        {
          "name": "Agents",
          "$id": "agents",
          "enabled": true,
          "attributes": [
            {
              "key": "syndicate_id",
              "type": "string",
              "required": true
            },
            {
              "key": "name",
              "type": "string",
              "required": true
            },
            {
              "key": "type",
              "type": "string",
              "required": true
            },
            {
              "key": "description",
              "type": "text",
              "required": false
            },
            {
              "key": "avatar_url",
              "type": "url",
              "required": false
            },
            {
              "key": "config",
              "type": "text",
              "required": false
            },
            {
              "key": "created_at",
              "type": "datetime",
              "required": true
            },
            {
              "key": "updated_at",
              "type": "datetime",
              "required": false
            }
          ],
          "indexes": [
            {
              "key": "syndicate_id",
              "type": "key",
              "attributes": ["syndicate_id"]
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "name": "Process Workflow",
      "$id": "process-workflow",
      "runtime": "node-18.0",
      "path": "backend/functions/process-workflow.ts",
      "entrypoint": "default",
      "enabled": true,
      "events": [],
      "schedule": "",
      "timeout": 60
    },
    {
      "name": "CRM Operations",
      "$id": "crm-operations",
      "runtime": "node-18.0",
      "path": "backend/functions/crm-operations.ts",
      "entrypoint": "default",
      "enabled": true,
      "events": [],
      "timeout": 60
    },
    {
      "name": "Treasury Operations",
      "$id": "treasury-operations",
      "runtime": "node-18.0",
      "path": "backend/functions/treasury-operations.ts",
      "entrypoint": "default",
      "enabled": true,
      "events": [],
      "timeout": 60
    },
    {
      "name": "Stripe Create Payment Intent",
      "$id": "stripe-create-payment-intent",
      "runtime": "node-18.0",
      "path": "backend/functions/stripe-create-payment-intent.ts",
      "entrypoint": "default",
      "enabled": true,
      "events": [],
      "timeout": 60
    },
    {
      "name": "Stripe Webhook Handler",
      "$id": "stripe-webhook-handler",
      "runtime": "node-18.0",
      "path": "backend/functions/stripe-webhook-handler.ts",
      "entrypoint": "default",
      "enabled": true,
      "events": [],
      "timeout": 60
    },
    {
      "name": "Stripe Connect Onboarding",
      "$id": "stripe-connect-onboarding",
      "runtime": "node-18.0",
      "path": "backend/functions/stripe-connect-onboarding.ts",
      "entrypoint": "default",
      "enabled": true,
      "events": [],
      "timeout": 60
    }
  ],
  "buckets": [
    {
      "name": "Avatars",
      "$id": "avatars",
      "permissions": [],
      "fileSecurity": false,
      "enabled": true
    },
    {
      "name": "Documents",
      "$id": "documents",
      "permissions": [],
      "fileSecurity": true,
      "enabled": true
    },
    {
      "name": "Media",
      "$id": "media",
      "permissions": [],
      "fileSecurity": false,
      "enabled": true
    }
  ]
}
