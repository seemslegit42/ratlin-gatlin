{
  "name": "λξvos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "dev:all": "concurrently -n vite,mcp -c blue,green \"vite\" \"bun run dev:mcp\"",
    "dev:mcp": "bun run backend/postman-mcp-server.ts",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "env:automate": "bun run scripts/env-automator.ts",
    "cast": "bun run scripts/cast.ts",
    "cast:deploy": "DOKPLOY=1 bun run scripts/cast.ts --deploy",
    "cast:down": "bun run scripts/cast.ts --down",
    "cast:status": "bun run scripts/cast.ts --status",
    "ollama:register-qwen-local": "bash scripts/register-local-gguf-ollama.sh",
    "ollama:register-gguf-models": "bash scripts/register-gguf-models.sh",
    "file-janitor": "bun run backend/fileJanitor.ts",
    "types:generate": "bun run scripts/generate-appwrite-types.ts",
    "types:appwrite": "bun run scripts/generate-appwrite-types.ts",
    "types:strict": "bun run scripts/generate-appwrite-types.ts --strict"
  },
  "dependencies": {
    "@mediapipe/tasks-genai": "^0.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.0",
    "@tabler/icons-react": "^3.49.0",
    "@tursodatabase/database": "^0.5.3",
    "appwrite": "^23.0.0",
    "concurrently": "^10.0.0",
    "framer-motion": "^12.23.26",
    "nanoid": "^5.1.6",
    "node-appwrite": "^24.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-draggable": "^4.5.0",
    "react-router-dom": "^7.11.0",
    "stripe": "^18.5.0",
    "three": "^0.182.0",
    "zod": "^4.4.3",
    "expo": "^52.0.0",
    "react-native": "0.76.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.0.0",
    "expo-status-bar": "^2.0.0",
    "expo-haptics": "^14.0.0",
    "expo-linear-gradient": "^14.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@vitejs/plugin-react": "^5.0.0",
    "bun-types": "^1.3.13",
    "express": "^5.2.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "babel-preset-expo": "^12.0.0"
  }
}